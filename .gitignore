# Local environment / credentials
cdc-pipeline/mysql-cdc-env.sh

# Deployed snapshots with resolved secrets, account IDs and bucket names.
# Unanchored so it also catches subdirectories such as
# monitoring/monitor-deployment-deployed.yaml — the earlier top-level-only
# pattern let that file through as untracked, and it carries a real account ID.
*-deployed.yaml

# Runtime logs
*.log
cdc-pipeline/bench-results
#python
*pycache*
# Account-specific values for throughput-benchmark/.bench-env
.bench-env.local
# monitoring/run.sh collector pids
throughput-benchmark/monitoring/.collectors.pid
# Maven build output
throughput-benchmark/datagen/sqs-delta-filename/target/
#benchmark results
throughput-benchmark/querybench/bench-results/

# Editors and IDEs: per-user settings and language-server state
.vscode/
.idea/
*.iml
# Scala Metals (and the Bloop / BSP build servers it starts)
.metals/
.bloop/
.bsp/
# macOS Finder metadata
.DS_Store
# Python local environments and tool caches
.venv/
venv/
.pytest_cache/
# throughput-benchmark/querybench/run.sh writes this while bundling a Job, then deletes it
throughput-benchmark/.qb-runner-cmd.sh
