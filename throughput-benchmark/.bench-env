# source this before running build-deploy-cid.sh
#
# NOTE: every value here OVERRIDES build-deploy-cid.sh's default, because
# the script uses ${VAR:-default}. So a knob changed in the script but left
# stale here has no effect. 

# Account-specific values live in .bench-env.local (git-ignored), sourced here
# so it overrides the placeholders below. Create it with your own:
#   export AWS_ACCOUNT_ID=<id>
#   export BUCKET_NAME=emr-on-eks-test-<id>-us-west-2
#   export EMR_EXECUTION_ROLE_ARN=arn:aws:iam::<id>:role/emr-on-eks-test-execution-role
export AWS_REGION=us-west-2
export AWS_ACCOUNT_ID=account
export BUCKET_NAME=emr-on-eks-test-account-us-west-2
export EMR_EXECUTION_ROLE_ARN=arn:aws:iam::account:role/emr-on-eks-test-execution-role
_bench_env_dir=$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)
[ -f "$_bench_env_dir/.bench-env.local" ] && source "$_bench_env_dir/.bench-env.local"
unset _bench_env_dir
export IMAGE_TAG=7.13.0

# 160 subtasks per side to meet the 8 GiB/s throughput requirement set just
# below (SOURCE_ROWS_PER_SECOND). The script's own default is 128.
#
# Paimon defaults to unaware-bucket (PAIMON_BUCKETS=-1, no shuffle, the same
# layout as Iceberg), so parallelism no longer sets a bucket count. For a
# fixed-bucket run, export PAIMON_BUCKETS=$JOB_PARALLELISM (one bucket per writer)
# and drop cid_events first: the bucket count is baked in at CREATE TABLE.
export JOB_PARALLELISM=160

# 8 GiB/s at the calibrated 4KB mean row = 8*1024^3 / 4096 = 2,097,152 rows/s
export SOURCE_ROWS_PER_SECOND=2097152

# 80/20 endpoint skew: 80% of events on a hot 5% slice of CID_HOST_COUNT.
# This CHANGES THE GENERATED BYTES (endpoint columns dictionary-encode better),
# so results here are not comparable with the uniform default of 0.
export HOT_KEY_FRACTION=80

# Paimon's per-commit Iceberg V2 metadata export to Glue (sets the table's
# 'metadata.iceberg.storage' = 'hive-catalog'; 'disabled' when false). BAKED
# INTO THE PAIMON TABLE SCHEMA at CREATE TABLE.
#
# Turned on so the Paimon table is externally readable as Iceberg. Without it,
# DuckDB has no manifest to read on the Paimon side and has to fall back to
# read_parquet over the raw files, which cannot prune by column statistics —
# that made the previous DuckDB comparison a read-path comparison rather than a
# format comparison. It is also commit-path work the Iceberg side does not pay,
# so the Paimon write numbers here are NOT comparable with ICEBERG_COMPAT=false
# runs.
export ICEBERG_COMPAT=true

export S3A_MULTIPART_SIZE=32M
export S3A_MULTIPART_THRESHOLD=32M

# Which source the Flink jobs read (build-deploy-cid.sh uploads it as 00-source.sql).
#   datagen — the original in-memory generator (01-datagen-source.sql). TO SWITCH
#             BACK set SOURCE_MODE=datagen (or delete the line: it is the default).
#   s3json  — continuously read the gzip NDJSON that jsongz-gen/ lands under
#             S3JSON_SOURCE_PATH (default s3a://<bucket>/cid-landing-jsongz/).
#             Start the generator first: ./jsongz-gen/run-jsongz-gen.sh start
export SOURCE_MODE=s3json

# The landing prefix, shared by the generator (OUTPUT_URI) and the jobs
# (S3JSON_SOURCE_PATH) — keep the two in step. On (re)start the filesystem
# source lists this whole tree SYNCHRONOUSLY on the JobMaster's RPC thread; a
# large backlog blocks it past the 60 s ask timeout and the JM crash-loops
# (exit 239, "requestJobStatus ... timed out"). So each run gets a fresh
# prefix. The original cid-landing-jsongz/ (two 30-min generator runs) was
# abandoned for this reason.
export OUTPUT_URI=s3://${BUCKET_NAME}/cid-landing-jsongz-r3
export S3JSON_SOURCE_PATH=s3a://${BUCKET_NAME}/cid-landing-jsongz-r3/
